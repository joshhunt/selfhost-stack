discovery.docker "default" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_containers" {
  // Read from
  targets = discovery.docker.default.targets

  rule {
    action = "replace"
    source_labels = ["__meta_docker_container_name"]
    regex = "/(.*)"
    replacement = "$1"
    target_label = "docker_container_name"
  }

  rule {
    action = "replace"
    source_labels = ["docker_container_name"]
    target_label = "service"
  }

  rule {
    action = "replace"
    source_labels = ["__meta_docker_container_label_build_version"]
    target_label = "docker_container_build_version"
  }

  rule {
    action = "replace"
    source_labels = ["__meta_docker_container_label_org_opencontainers_image_title"]
    target_label = "docker_image_title"
  }

  rule {
    action = "replace"
    source_labels = ["__meta_docker_container_label_org_opencontainers_image_version"]
    target_label = "docker_image_version"
  }

  rule {
    action = "replace"
    source_labels = ["__meta_docker_container_label_org_opencontainers_image_revision"]
    target_label = "docker_image_revision"
  }

  rule {
    action = "replace"
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label = "docker_compose_project"
  }

  rule {
    action = "labeldrop"
    regex = "service_name"
  }

  // This exposes an output
}

loki.source.docker "default" {
  // Read from
  targets = discovery.relabel.docker_containers.output
  host = "unix:///var/run/docker.sock"

  labels = {
    "job" = "docker",
    "project" = "selfhost-stack",
  }

  // Write to
  forward_to = [helpers.for_host.publish_logs]
}

prometheus.scrape "docker" {
  // Read from
  targets = discovery.relabel.docker_containers.output

  // Write to
  forward_to = [prometheus.relabel.docker_relabel.receiver]
}

prometheus.relabel "docker_relabel" {
  rule {
    action = "keep"
    source_labels = ["__name__"]
    regex = "up"
  }

	rule {
    target_label = "job"
    replacement  = "docker"
  }

  rule {
    target_label = "project"
    replacement  = "selfhost-stack"
  }

  // Write to
  forward_to = [helpers.for_host.publish_metrics]
}