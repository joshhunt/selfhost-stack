prometheus.scrape "iperf" {
  // Read from
  targets = [{
    __scheme__ = "https",
    __address__ = "iperf-collector.trtr.co:443",
    "job" = "iperf",
    "project" = "selfhost-stack",
    "service" = "iperf",
  }]

  // Write to
  forward_to = [prometheus.relabel.iperf_relabel.receiver]
}

prometheus.relabel "iperf_relabel" {
  // rule {
  //   source_labels = ["__name__"]
