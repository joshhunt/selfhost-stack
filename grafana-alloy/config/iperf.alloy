  //   replacement = "radarr"
  // }

  // rule {
  //   source_labels = ["__name__"]
  //   regex = "prowlarr_.+"
  //   target_label = "service"
  //   replacement = "prowlarr"
  // }

  // Write to
  forward_to = [helpers.for_host.publish_metrics]
}

