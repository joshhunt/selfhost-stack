prometheus.scrape "scraparr" {
  // Read from
  targets = [{
    __scheme__ = "https",
    __address__ = "scraparr.trtr.co:443",
    "job" = "scraparr",
    "project" = "selfhost-stack",
    "service" = "scraparr",
  }]

  relabel_configs = [
    {
      source_labels = ["__name__"],
      regex = "sonarr_.+",
      target_label = "service",
      replacement = "sonarr",
    },
    {
      source_labels = ["__name__"],
      regex = "radarr_.+",
      target_label = "service",
      replacement = "radarr",
    },
    {
      source_labels = ["__name__"],
      regex = "prowlarr_.+",
      target_label = "service",
      replacement = "prowlarr",
    },
  ]

  // Write to
  forward_to = [helpers.for_host.publish_metrics]
}

