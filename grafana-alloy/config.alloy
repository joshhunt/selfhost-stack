logging {
  level  = "debug"
  format = "logfmt"
}

livedebugging {
  enabled = true
}

local.file "secrets" {
  filename = "/run/secrets/grafana-alloy-secrets-file"
  // is_secret = true
}

discovery.docker "default" {
  host = "unix:///var/run/docker.sock"
}

loki.source.docker "default" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.default.targets
  labels     = {"app" = "docker"}
  forward_to = []
}

loki.write "default" {
    endpoint {
        url = json_path(local.file.secrets.content, "logs_url")[0]
        basic_auth {
            username = json_path(local.file.secrets.content, "logs_user")[0]
            password = json_path(local.file.secrets.content, "token")[0]
        }
    }
}