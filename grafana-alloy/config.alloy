logging {
  level  = "debug"
  format = "logfmt"
}

livedebugging {
  enabled = true
}

local.file "token" {
  filename = "/run/secrets/grafana-alloy-token"
  is_secret = true
}

local.file "loki_url" {
  filename = "/run/secrets/grafana-alloy-loki-url"
}

local.file "loki_user" {
  filename = "/run/secrets/grafana-alloy-loki-user"
}

local.file "prom_url" {
  filename = "/run/secrets/grafana-alloy-prom-url"
}

local.file "prom_user" {
  filename = "/run/secrets/grafana-alloy-prom-user"
}

discovery.docker "default" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "default" {
  targets = discovery.docker.default.targets

  rule {
    action = "replace"
    source_labels = ["__meta_docker_container_name"]
    regex = "/(.*)"
    replacement = "$1"
    target_label = "container"
  }

  rule {
    action = "replace"
    source_labels = ["__meta_docker_container_label_build_version"]
    target_label = "container_build_version"
  }

  rule {
    action = "replace"
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label = "compose_project"
  }
}

loki.source.docker "default" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.default.output
  labels     = {"app" = "docker", "job" = "selfhost-stack"}
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
    endpoint {
        url = local.file.loki_url.content
        basic_auth {
            username = local.file.loki_user.content
            password = local.file.token.content
        }
    }
}

prometheus.scrape "traefik" {
  targets    = [{
    __address__ = "traefik:8080",
    "app" = "traefik",
    "job" = "selfhost-stack",
  }]
  forward_to = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
    endpoint {
        url = local.file.prom_url.content
        basic_auth {
            username = local.file.prom_user.content
            password = local.file.token.content
        }
    }
}